#!/bin/bash

subid=SUB
sesid=SES
project_dir=BASE

## load dependencies and set paths 
module load gcc/9.2.0
module load matlab/R2019a
module load afni
module load fsl

anat_dir="${project_dir}/bids/sub-${subid}/ses-${sesid}/anat"
bids_dir="${project_dir}/bids" 
code_dir="${project_dir}/code"
deriv_dir="${project_dir}/derivatives/nordic"

if [ ! -d ${anat_dir} ]; then
	echo "Dir not found:" ${anat_dir}
fi

if [ ! -d ${bids_dir} ]; then
	echo "Dir not found:" ${bids_dir}
fi

if [ ! -d ${anat_dir} ]; then
	echo "Dir not found:" ${code_dir}
fi

start_bias_field_correction() {
    infile="$1"
    outfile="$2"
    code_dir="$3"

    # Extract the directory and base filename (without extension)
    indir=$(dirname "${infile}")
    base=$(basename "${infile}" .nii.gz)  # Assuming the infile ends with .nii.gz

    work=/tmp/biasfield/${base}

    if [ ! -d ${work} ]; then
        mkdir -p ${work}
    fi

    cp ${infile} ${work}

    pushd ${work}
    # Prepare the output file path by appending "_bico" before the .nii.gz extension
    cp ${code_dir}/Bias_field_script_job.m ${work}

    # Use 3dcalc to copy the input to a temporary uncompressed NIfTI file (intermediate step)
    3dcalc -a "${infile}" -expr 'a' -prefix uncorr.nii -overwrite

    echo "Running MATLAB SPM bias field correction..."
    # Assuming Bias_field_script_job is correctly set up to use uncorr.nii and save the output as muncorr.nii
    matlab -nodesktop -nosplash -r "Bias_field_script_job; exit"

    # Use 3dcalc to ensure the data format, work with muncorr.nii, and save the output
    3dcalc -a muncorr.nii -expr 'a' -prefix muncorr.nii -overwrite -datum short

    # Compress the corrected file to the desired output path
    3dcalc -a muncorr.nii -expr 'a' -prefix "${outfile}" -overwrite

    # rm -f Bias_field_script_job.m
    rm -f *uncorr* 

    # Clean up intermediate uncompressed file if needed
    popd 

    echo "Bias Correction completed successfully."
}


############### 1) DENOISE + BIAS-FIELD-CORRECT THE ANATOMICALS ###########

echo "Running denoise + BFC..."

# Detect MP2RAGE files (with or without a run-label) ----------------------

INV1_FILE=$(ls ${anat_dir}/sub-${subid}_ses-${sesid}_*inv-1*_MP2RAGE.nii.gz 2>/dev/null | head -n 1)
INV2_FILE=$(ls ${anat_dir}/sub-${subid}_ses-${sesid}_*inv-2*_MP2RAGE.nii.gz 2>/dev/null | head -n 1)
UNI_FILE=$(ls  ${anat_dir}/sub-${subid}_ses-${sesid}_*UNIT1.nii.gz  2>/dev/null | head -n 1)

# If old BIDS conversion
if [[ -z "$INV1_FILE" ]]; then
    INV1_FILE=$(ls ${anat_dir}/sub-${subid}_ses-${sesid}_acq-inv1*_T1w.nii.gz 2>/dev/null | head -n 1) 
fi

if [[ -z "$INV2_FILE" ]]; then
    INV2_FILE=$(ls ${anat_dir}/sub-${subid}_ses-${sesid}_acq-inv2*_T1w.nii.gz 2>/dev/null | head -n 1)
fi

if [[ -z "$UNI_FILE" ]]; then
    UNI_FILE=$(ls  ${anat_dir}/sub-${subid}_ses-${sesid}_acq-uni*_T1w.nii.gz  2>/dev/null | head -n 1)
fi

if [[ -z "$INV1_FILE" || -z "$INV2_FILE" || -z "$UNI_FILE" ]]; then
    echo "L  Could not find expected MP2RAGE files in ${anat_dir}.  Skipping denoise/BFC."
else
    # Determine whether a _run-?? label was present
    [[ "$INV1_FILE" == *"_run-"* ]] && RUN_SUFFIX="" || RUN_SUFFIX="_run-01"

    echo "='  MP2RAGE denoising via LayNii..."
    pushd /projects/standard/faird/shared/projects/7Tpiloting/anat_testing/scripts/LayNii  >/dev/null
    ./LN_MP2RAGE_DNOISE \
            -INV1  "$INV1_FILE" \
            -INV2  "$INV2_FILE" \
            -UNI   "$UNI_FILE" \
            -beta  0.5 \
            -output "${anat_dir}/sub-${subid}_ses-${sesid}_acq-unidenoised${RUN_SUFFIX}_T1w.nii.gz"
    popd >/dev/null

    echo "='  Bias-field correction..."
    start_bias_field_correction "${anat_dir}/sub-${subid}_ses-${sesid}_acq-unidenoised${RUN_SUFFIX}_T1w.nii.gz" "${anat_dir}/sub-${subid}_ses-${sesid}_acq-unidenoisedbfc${RUN_SUFFIX}_T1w.nii.gz" "${code_dir}"
    cp "${UNI_FILE%.nii.gz}.json" \
        "${anat_dir}/sub-${subid}_ses-${sesid}_acq-unidenoisedbfc${RUN_SUFFIX}_T1w.json"

    # ---- Do the same for any T2w --------------------------------------------------
    T2W_FILE=$(ls ${anat_dir}/sub-${subid}_ses-${sesid}*_T2w.nii.gz 2>/dev/null | head -n 1)
    if [[ -n "$T2W_FILE" ]]; then
        [[ "$T2W_FILE" == *"_run-"* ]] && T2W_RUN_SUFFIX="" || T2W_RUN_SUFFIX="_run-01"
        start_bias_field_correction "$T2W_FILE" "${anat_dir}/sub-${subid}_ses-${sesid}_acq-bfc${T2W_RUN_SUFFIX}_T2w.nii.gz" "${code_dir}"
        cp "${T2W_FILE%.nii.gz}.json" \
            "${anat_dir}/sub-${subid}_ses-${sesid}_acq-bfc${T2W_RUN_SUFFIX}_T2w.json"
    fi
fi

########### 2) GENERATE FAKE AP FMAP ###########

echo "Running fake-forward-EPI creation..."

python ${code_dir}/IntendedFor_JSBR_prenordic.py ${bids_dir} --sub sub-${subid} --ses ${sesid} --assign-mode lookback --write
# python "${code_dir}/generate_fake_ap.py" "${bids_dir}" "${subid}" ${sesid}
# python ${code_dir}/IntendedFor_JSBR_prenordic.py ${bids_dir} --sub sub-${subid} --ses ${sesid} --assign-mode lookback --write

## Clean up anat folder  
${code_dir}/cleanup_7T_anat.sh ${subid} ${sesid} --src-base ${bids_dir} --dst-base ${deriv_dir}

## Clean up fmap folder
 if [ -d ${deriv_dir}/sub-${subid}/ses-${sesid}/fmap/ ]; then
     rm -f ${deriv_dir}/sub-${subid}/ses-${sesid}/fmap/*
 fi

 cp ${bids_dir}/sub-${subid}/ses-${sesid}/fmap/* ${deriv_dir}/sub-${subid}/ses-${sesid}/fmap/

## Crop T1 image 
mkdir /projects/standard/lewi1538/shared/projects/neg_urg/derivatives/cleaned_anats/sub-${subid}_ses-${sesid}/
mv /projects/standard/lewi1538/shared/projects/neg_urg/derivatives/nordic/sub-${subid}/ses-${sesid}/anat/sub-${subid}_ses-${sesid}_run-01_T1w.nii.gz /projects/standard/lewi1538/shared/projects/neg_urg/derivatives/cleaned_anats/sub-${subid}_ses-${sesid}/
fslroi  /projects/standard/lewi1538/shared/projects/neg_urg/derivatives/cleaned_anats/sub-${subid}_ses-${sesid}/sub-${subid}_ses-${sesid}_run-01_T1w.nii.gz /projects/standard/lewi1538/shared/projects/neg_urg/derivatives/nordic/sub-${subid}/ses-${sesid}/anat/sub-${subid}_ses-${sesid}_run-01_T1w.nii.gz 0 224 7 320 0 256

## Correct fmap intended for fields 
python /projects/standard/faird/shared/code/internal/utilities/files_handling/rewrite_paths_data_migration/rewrite_paths_and_terms.py ${deriv_dir}/sub-${subid}/ses-${sesid}/fmap/ --replace-old-term "task_" --replace-new-term "taskNORDIC_" --show-diff --apply
python /projects/standard/faird/shared/code/internal/utilities/files_handling/rewrite_paths_data_migration/rewrite_paths_and_terms.py ${deriv_dir}/sub-${subid}/ses-${sesid}/fmap/ --replace-old-term "rest_" --replace-new-term "restNORDIC_" --show-diff --apply

python /projects/standard/faird/shared/code/internal/utilities/files_handling/rewrite_paths_data_migration/rewrite_paths_and_terms.py ${deriv_dir}/sub-${subid}/ses-${sesid}/fmap/ --replace-old-term "_part-mag_" --replace-new-term "_" --show-diff --apply

# Remove backups created by rewrite commands
rm ${deriv_dir}/sub-${subid}/ses-${sesid}/fmap/*MIGRATE*

## NOTE: will need to remove backups created by ^^
