#!/bin/bash

subj_id=SUBID
ses_id=SESID
data_dir=DATADIR
bids_path=INPUT
output_path=OUTPUT
run_dir=RUNDIR
cpu_usage=8
singularity=`which singularity`

# pull down needed data and files from input bucket
if [ ! -d ${data_dir}/bids_dir/sub-${subj_id}_ses-${ses_id}/sub-${subj_id}/ses-${ses_id} ]; then
	mkdir -p ${data_dir}/bids_dir/sub-${subj_id}_ses-${ses_id}/sub-${subj_id}
	cp ${bids_path}/sub-${subj_id}/ses-${ses_id} ${data_dir}/bids_dir/sub-${subj_id}_ses-${ses_id}/sub-${subj_id} --recursive -v
fi

if [ ! -e ${data_dir}/bids_dir/sub-${subj_id}_ses-${ses_id}/dataset_description.json ]; then
	cp ${run_dir}/dataset_description.json ${data_dir}/bids_dir/sub-${subj_id}_ses-${ses_id} -v
fi

# create fmriprep scratch output and workdirs
if [ ! -d ${data_dir}/processed/fmriprep/sub-${subj_id}_ses-${ses_id} ]; then
	mkdir -p ${data_dir}/processed/fmriprep/sub-${subj_id}_ses-${ses_id}
fi

if [ ! -d ${data_dir}/work_dir/fmriprep/sub-${subj_id}_ses-${ses_id} ]; then
	mkdir -p ${data_dir}/work_dir/fmriprep/sub-${subj_id}_ses-${ses_id}
fi

fmriprep_version=25.2.2
# #fmriprep command  
env -i ${singularity} run --cleanenv \
  -B /tmp:/tmp \
  -B ${data_dir}/bids_dir/sub-${subj_id}_ses-${ses_id}:/bids_dir \
  -B ${data_dir}/processed/fmriprep/sub-${subj_id}_ses-${ses_id}:/output_dir \
  -B ${data_dir}/work_dir/fmriprep/sub-${subj_id}_ses-${ses_id}:/wd \
  -B /projects/standard/faird/shared/code/external/utilities/freesurfer_license/license.txt:/opt/freesurfer/license.txt \
  /projects/standard/faird/shared/code/external/pipelines/fmriprep/fmriprep_${fmriprep_version}.sif \
  --output-spaces MNI152NLin6Asym:res-2:res-native \
  --fs-license-file /opt/freesurfer/license.txt \
  --project-goodvoxels \
  --use-syn-sdc \
  --skull-strip-fixed-seed \
  --random-seed 1\
  --omp-nthreads 3 \
  --cifti-output 91k \
  --bold2anat-init auto \
  --participant-label ${subj_id} \
  -vv \
  -w /wd \
/bids_dir /output_dir participant 

if [ ! -d /projects/standard/lewi1538/shared/projects/neg_urg/derivatives/fmriprep/work_dirs/ ]; then
	mkdir -p /projects/standard/lewi1538/shared/projects/neg_urg/derivatives/fmriprep/work_dirs/
fi

if [ ! -d /projects/standard/lewi1538/shared/projects/neg_urg/derivatives/fmriprep/sub-${subj_id}/ ]; then
	mkdir -p /projects/standard/lewi1538/shared/projects/neg_urg/derivatives/fmriprep/sub-${subj_id}/
fi

# push outputs to s3
s3cmd sync --recursive -v ${data_dir}/processed/fmriprep/sub-${subj_id} ${output_path}/fmriprep/sub-${subj_id}
cp -r -v ${data_dir}/processed/fmriprep/sub-${subj_id}_ses-${ses_id}/* /projects/standard/lewi1538/shared/projects/neg_urg/derivatives/fmriprep/sub-${subj_id}/

